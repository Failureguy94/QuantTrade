APP_NAME=Quant API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://quant:quant@localhost:5433/quant
# Security & Authentication (Argon2id + JWT)
# In production, JWT_SECRET must be at least 32 characters long and not use the default placeholder.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:3000"]

# Paper trading fill model (basis points; 1 bp = 0.01%)
PAPER_COMMISSION_BPS=5
PAPER_SLIPPAGE_BPS=2
# Reference quotes: reuse window, and the oldest price an order may fill against
QUOTE_CACHE_TTL_SECONDS=60
QUOTE_MAX_AGE_DAYS=7

# Sessions and emailed links
REFRESH_TOKEN_DAYS=30
FRONTEND_BASE_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
# "console" writes emails to the log; "smtp" sends them (set the SMTP_* values)
EMAIL_BACKEND=console
EMAIL_FROM=Quant <no-reply@quant.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Abuse limits (counted per API process)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_BACKTESTS_PER_MINUTE=12
RATE_LIMIT_RISK_PER_MINUTE=30
RATE_LIMIT_MARKET_DATA_PER_MINUTE=60

# Logging: text or json (json is the default when APP_ENV=production)
LOG_FORMAT=
SENTRY_DSN=

# Background worker (queued backtests, limit-order matcher). Runs inside the API
# process unless WORKER_EMBEDDED=false, in which case start `python -m app.worker`.
WORKER_EMBEDDED=true
MATCHER_INTERVAL_SECONDS=60

# Prices: "yahoo", or "synthetic" for made-up but repeatable prices (never production)
MARKET_DATA_PROVIDER=yahoo
